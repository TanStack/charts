{
  "schemaVersion": 1,
  "referenceRenderer": "echarts",
  "order": 880,
  "id": "88-echarts-free-cursor",
  "title": "Free two-dimensional cursor",
  "family": "interaction",
  "intent": "Track an unconstrained x and y plot position without snapping to the nearest datum.",
  "support": "composed",
  "features": [
    "free cursor",
    "two-dimensional crosshair",
    "normalized plot state",
    "semantic fractional target",
    "case-owned overlay",
    "rendered coordinate labels",
    "paired semantic sliders",
    "tap-to-pin cursor"
  ],
  "geometry": [
    {
      "id": "free-cursor-line",
      "view": "main",
      "role": "line",
      "count": 1
    },
    {
      "id": "free-cursor-dots",
      "view": "main",
      "role": "dot",
      "count": 6
    }
  ],
  "minimumGeometrySimilarity": 0.995,
  "guideAssertions": [
    {
      "id": "value-sequence",
      "axis": "y",
      "sequence": ["0", "20", "40", "60", "80", "100"]
    }
  ],
  "interactionScenarios": [
    {
      "id": "track-fractional-plot-position",
      "steps": [
        {
          "type": "pointerMove",
          "target": {
            "view": "main",
            "anchor": "fraction:0.37,0.64"
          }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "cursor.visible", "equals": true },
            {
              "path": "cursor.xNormalized",
              "approx": 0.37,
              "tolerance": 0.015
            },
            {
              "path": "cursor.yNormalized",
              "approx": 0.64,
              "tolerance": 0.015
            },
            {
              "path": "cursor.xValue",
              "approx": 37,
              "tolerance": 1.5
            },
            {
              "path": "cursor.yValue",
              "approx": 36,
              "tolerance": 1.5
            },
            { "path": "cursor.pinned", "equals": false },
            { "path": "cursor.snapped", "equals": false },
            { "path": "cursor.datum", "equals": null },
            { "path": "render.count", "equals": 1 }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": {
                "selector": "[data-conformance-free-cursor-status]"
              },
              "property": "text",
              "includes": "X 37"
            },
            {
              "target": {
                "selector": "[data-conformance-free-cursor-status]"
              },
              "property": "text",
              "includes": "Y 36"
            }
          ]
        },
        { "type": "screenshot", "name": "free-cursor-values" },
        { "type": "pointerLeave", "view": "main" },
        {
          "type": "assert",
          "assertions": [
            { "path": "cursor.visible", "equals": false },
            { "path": "cursor.xNormalized", "equals": null },
            { "path": "cursor.yNormalized", "equals": null }
          ]
        },
        {
          "type": "key",
          "key": "ArrowRight",
          "target": { "view": "main", "anchor": "control:x" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "cursor.visible", "equals": true },
            { "path": "cursor.xValue", "equals": 38 },
            { "path": "cursor.yValue", "equals": 36 },
            { "path": "cursor.pinned", "equals": true },
            { "path": "render.count", "equals": 1 }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": {
                "selector": "[data-conformance-free-cursor-status]"
              },
              "property": "text",
              "includes": "X 38"
            },
            {
              "target": { "role": "slider", "name": "X coordinate" },
              "property": "focused",
              "equals": true
            }
          ]
        },
        { "type": "pointerLeave", "view": "main" },
        {
          "type": "assert",
          "assertions": [
            { "path": "cursor.visible", "equals": true },
            { "path": "cursor.pinned", "equals": true }
          ]
        },
        { "type": "key", "key": "Escape" },
        {
          "type": "assert",
          "assertions": [
            { "path": "cursor.visible", "equals": false },
            { "path": "cursor.pinned", "equals": false }
          ]
        },
        {
          "type": "touchTap",
          "target": {
            "view": "main",
            "anchor": "fraction:0.25,0.25"
          }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "cursor.visible", "equals": true },
            { "path": "cursor.xValue", "equals": 25 },
            { "path": "cursor.yValue", "equals": 75 },
            { "path": "cursor.pinned", "equals": true },
            { "path": "render.count", "equals": 1 }
          ]
        }
      ]
    }
  ],
  "source": {
    "title": "Apache ECharts cross axis pointer",
    "url": "https://echarts.apache.org/handbook/en/concepts/axis/"
  },
  "ai": {
    "create": "Create a free two-dimensional crosshair that reports normalized plot coordinates at arbitrary pointer positions without selecting a datum.",
    "maintain": "Keep cursor movement DOM-only, constrain it to resolved chart bounds, hide it on leave, and preserve one chart render while pointer state changes."
  }
}
