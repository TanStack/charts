{
  "schemaVersion": 1,
  "referenceRenderer": "echarts",
  "order": 910,
  "id": "91-timeline-playback-scrubber",
  "title": "Timeline playback scrubber",
  "family": "interaction",
  "intent": "Scrub a semantic playhead through stable time frames with a direct drag while keeping the chart data controlled.",
  "support": "composed",
  "features": [
    "timeline playback",
    "semantic playhead",
    "real pointer drag",
    "snapped time frames",
    "controlled application overlay",
    "native semantic range input",
    "keyboard scrubbing",
    "44 pixel hit target",
    "play and pause control",
    "live frame status"
  ],
  "geometry": [
    { "id": "playback-line", "view": "main", "role": "line", "count": 1 },
    { "id": "playback-points", "view": "main", "role": "dot", "count": 8 },
    { "id": "scrubber-rules", "view": "main", "role": "rule", "count": 2 }
  ],
  "minimumGeometrySimilarity": 0.995,
  "guideAssertions": [
    {
      "id": "value-sequence",
      "axis": "y",
      "sequence": ["20", "40", "60", "80"]
    }
  ],
  "interactionScenarios": [
    {
      "id": "scrub-forward",
      "steps": [
        {
          "type": "assert",
          "assertions": [
            { "path": "playhead.index", "equals": 2 },
            { "path": "playhead.date", "equals": "2025-01-15" },
            { "path": "playhead.value", "equals": 39 },
            { "path": "interaction.dragging", "equals": false }
          ]
        },
        {
          "type": "drag",
          "from": { "view": "main", "anchor": "frame:2025-01-15" },
          "to": { "view": "main", "anchor": "frame:2025-02-12" },
          "steps": 12
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "playhead.index", "equals": 6 },
            { "path": "playhead.date", "equals": "2025-02-12" },
            { "path": "playhead.value", "equals": 66 },
            {
              "path": "playhead.progress",
              "approx": 0.8571428571,
              "tolerance": 0.000001
            },
            { "path": "interaction.dragging", "equals": false },
            { "path": "interaction.scrubCount", "equals": 1 },
            {
              "path": "frames.ids",
              "equals": [
                "2025-01-01",
                "2025-01-08",
                "2025-01-15",
                "2025-01-22",
                "2025-01-29",
                "2025-02-05",
                "2025-02-12",
                "2025-02-19"
              ]
            }
          ]
        },
        { "type": "update", "revision": 1 },
        {
          "type": "assert",
          "assertions": [
            { "path": "playhead.index", "equals": 6 },
            { "path": "playhead.date", "equals": "2025-02-12" },
            { "path": "playhead.value", "equals": 66 },
            { "path": "frames.revisionProbeValue", "equals": 55 },
            { "path": "interaction.dragging", "equals": false },
            { "path": "interaction.scrubCount", "equals": 1 }
          ]
        },
        { "type": "update", "revision": 0 },
        {
          "type": "assert",
          "assertions": [
            { "path": "playhead.index", "equals": 6 },
            { "path": "playhead.date", "equals": "2025-02-12" },
            { "path": "playhead.value", "equals": 66 },
            { "path": "frames.revisionProbeValue", "equals": 51 },
            { "path": "interaction.dragging", "equals": false },
            { "path": "interaction.scrubCount", "equals": 1 }
          ]
        }
      ]
    },
    {
      "id": "scrub-backward",
      "steps": [
        {
          "type": "drag",
          "from": { "view": "main", "anchor": "frame:2025-01-15" },
          "to": { "view": "main", "anchor": "frame:2025-01-01" },
          "steps": 8
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "playhead.index", "equals": 0 },
            { "path": "playhead.date", "equals": "2025-01-01" },
            { "path": "playhead.progress", "approx": 0, "tolerance": 0 },
            { "path": "interaction.dragging", "equals": false },
            { "path": "interaction.scrubCount", "equals": 1 }
          ]
        }
      ]
    },
    {
      "id": "keyboard-scrub",
      "steps": [
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": { "role": "slider", "name": "Timeline frame" },
              "property": "height",
              "atLeast": 44
            },
            {
              "target": { "role": "button", "name": "Play timeline" },
              "property": "width",
              "atLeast": 44
            },
            {
              "target": { "role": "button", "name": "Play timeline" },
              "property": "height",
              "atLeast": 44
            },
            {
              "target": { "selector": ".ts-conformance-playback-track" },
              "property": "height",
              "equals": 4
            },
            {
              "target": { "selector": ".ts-conformance-playback-track" },
              "property": "width",
              "atLeast": 100
            },
            {
              "target": { "selector": ".ts-conformance-playback-handle" },
              "property": "width",
              "equals": 20
            },
            {
              "target": { "selector": ".ts-conformance-playback-handle" },
              "property": "height",
              "equals": 20
            },
            {
              "target": { "selector": ".ts-conformance-playback-toolbar" },
              "property": "contained",
              "within": { "root": true },
              "equals": true
            },
            {
              "target": { "role": "status" },
              "property": "count",
              "equals": 1
            }
          ]
        },
        {
          "type": "key",
          "key": "ArrowLeft",
          "target": { "view": "main", "anchor": "frame:2025-01-15" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "playhead.index", "equals": 1 },
            { "path": "playhead.date", "equals": "2025-01-08" },
            { "path": "playhead.value", "equals": 42 },
            { "path": "interaction.scrubCount", "equals": 1 },
            { "path": "interaction.playing", "equals": false }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": { "role": "slider", "name": "Timeline frame" },
              "property": "focused",
              "equals": true
            },
            {
              "target": {
                "selector": ".ts-conformance-playback-announcement"
              },
              "property": "text",
              "includes": "2025-01-08"
            }
          ]
        }
      ]
    },
    {
      "id": "cancel-scrub",
      "steps": [
        {
          "type": "pointerDown",
          "target": { "view": "main", "anchor": "frame:2025-01-15" }
        },
        {
          "type": "pointerMove",
          "target": { "view": "main", "anchor": "frame:2025-02-12" },
          "steps": 8
        },
        { "type": "pointerCancel" },
        {
          "type": "assert",
          "assertions": [
            { "path": "playhead.index", "equals": 2 },
            { "path": "playhead.date", "equals": "2025-01-15" },
            { "path": "interaction.dragging", "equals": false },
            { "path": "interaction.scrubCount", "equals": 0 }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": {
                "selector": ".ts-conformance-playback-announcement"
              },
              "property": "text",
              "includes": "2025-01-15"
            }
          ]
        }
      ]
    },
    {
      "id": "playback-lifecycle",
      "steps": [
        {
          "type": "key",
          "key": "End",
          "target": { "view": "main", "anchor": "frame:2025-01-15" }
        },
        {
          "type": "key",
          "key": "ArrowLeft",
          "target": { "view": "main", "anchor": "frame:2025-02-19" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "playhead.index", "equals": 6 },
            { "path": "playhead.date", "equals": "2025-02-12" },
            { "path": "interaction.playing", "equals": false }
          ]
        },
        {
          "type": "click",
          "target": { "view": "main", "anchor": "control:play" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "interaction.playing", "equals": true },
            { "path": "playhead.index", "equals": 6 }
          ]
        },
        { "type": "wait", "durationMs": 800 },
        {
          "type": "assert",
          "assertions": [
            { "path": "interaction.playing", "equals": true },
            { "path": "playhead.index", "equals": 7 },
            { "path": "playhead.date", "equals": "2025-02-19" }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": { "selector": ".ts-conformance-playback-current" },
              "property": "text",
              "includes": "2025-02-19"
            }
          ]
        },
        { "type": "wait", "durationMs": 800 },
        {
          "type": "assert",
          "assertions": [
            { "path": "interaction.playing", "equals": false },
            { "path": "playhead.index", "equals": 7 }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": {
                "selector": ".ts-conformance-playback-announcement"
              },
              "property": "text",
              "includes": "Playback ended"
            },
            {
              "target": { "role": "button", "name": "Play timeline" },
              "property": "attribute",
              "attribute": "aria-pressed",
              "equals": "false"
            }
          ]
        },
        {
          "type": "click",
          "target": { "view": "main", "anchor": "control:play" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "interaction.playing", "equals": true },
            { "path": "playhead.index", "equals": 0 },
            { "path": "playhead.date", "equals": "2025-01-01" }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": {
                "selector": ".ts-conformance-playback-announcement"
              },
              "property": "text",
              "includes": "Playback restarted"
            },
            {
              "target": { "role": "button", "name": "Pause timeline" },
              "property": "attribute",
              "attribute": "aria-pressed",
              "equals": "true"
            }
          ]
        },
        { "type": "wait", "durationMs": 800 },
        {
          "type": "assert",
          "assertions": [
            { "path": "interaction.playing", "equals": true },
            { "path": "playhead.index", "equals": 1 },
            { "path": "playhead.date", "equals": "2025-01-08" }
          ]
        },
        {
          "type": "click",
          "target": { "view": "main", "anchor": "control:play" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "interaction.playing", "equals": false },
            { "path": "playhead.index", "equals": 1 }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": {
                "selector": ".ts-conformance-playback-announcement"
              },
              "property": "text",
              "includes": "Playback paused"
            }
          ]
        }
      ]
    }
  ],
  "source": {
    "title": "Apache ECharts dynamic data",
    "url": "https://echarts.apache.org/examples/en/editor.html?c=dynamic-data2"
  },
  "ai": {
    "create": "Create a controlled UTC line chart with a native range input for the playback index, a visible playhead, play and pause control, keyboard support, and live frame status.",
    "maintain": "Keep frame identity and playback state outside the renderer, align the native range to resolved chart coordinates, cancel transient edits without committing them, and preserve the index across responsive and data revisions."
  }
}
