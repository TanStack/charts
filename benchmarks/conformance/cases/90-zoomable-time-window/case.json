{
  "schemaVersion": 1,
  "referenceRenderer": "echarts",
  "order": 900,
  "id": "90-zoomable-time-window",
  "title": "Wheel zoom and pan over AAPL closes",
  "family": "interaction",
  "intent": "Zoom a continuous time viewport around the pointer, pan the cropped domain, and restore the full extent.",
  "support": "native",
  "features": [
    "wheel zoom",
    "drag and horizontal wheel pan",
    "pointer-anchored semantic window",
    "clamped continuous viewport",
    "controlled semantic window",
    "resolved-scale inversion",
    "first-party zoom behavior",
    "keyboard and touch navigation",
    "intentional focus before wheel capture",
    "semantic reset control",
    "ECharts data zoom"
  ],
  "geometry": [
    { "id": "window-line", "view": "main", "role": "line", "count": 1 },
    { "id": "window-points", "view": "main", "role": "dot", "count": 12 }
  ],
  "minimumGeometrySimilarity": 0.98,
  "guideAssertions": [
    {
      "id": "non-repeating-value-ticks",
      "axis": "y",
      "maxRepeat": 1
    }
  ],
  "interactionScenarios": [
    {
      "id": "unfocused-wheel-is-not-captured",
      "steps": [
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": { "role": "status" },
              "property": "text",
              "equals": "Focus chart to zoom"
            },
            {
              "target": {
                "role": "application",
                "name": "Zoomable time window. Focus the chart before wheel zoom; drag or use a horizontal wheel to pan; use plus, minus, arrow keys, or Home.",
                "exact": true
              },
              "property": "focused",
              "equals": false
            }
          ]
        },
        {
          "type": "wheel",
          "target": { "view": "main", "anchor": "date:2018-01-10" },
          "deltaY": 240
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-02" },
            { "path": "viewport.end", "equals": "2018-01-18" },
            { "path": "interaction.active", "equals": false },
            { "path": "interaction.wheelCaptured", "equals": false },
            { "path": "interaction.last", "equals": "none" }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": { "page": true },
              "property": "scrollTop",
              "atLeast": 1
            }
          ]
        }
      ]
    },
    {
      "id": "zoom-pan-and-restore",
      "steps": [
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-02" },
            { "path": "viewport.end", "equals": "2018-01-18" },
            { "path": "viewport.spanDays", "approx": 16, "tolerance": 0.01 },
            { "path": "visible.count", "equals": 12 }
          ]
        },
        {
          "type": "click",
          "target": { "view": "main", "anchor": "date:2018-01-10" }
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": {
                "role": "application",
                "name": "Zoomable time window. Focus the chart before wheel zoom; drag or use a horizontal wheel to pan; use plus, minus, arrow keys, or Home.",
                "exact": true
              },
              "property": "focused",
              "equals": true
            },
            {
              "target": { "role": "status" },
              "property": "text",
              "includes": "2018-01-02 → 2018-01-18"
            }
          ]
        },
        {
          "type": "wheel",
          "target": { "view": "main", "anchor": "date:2018-01-10" },
          "deltaY": -240
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-06" },
            { "path": "viewport.end", "equals": "2018-01-14" },
            { "path": "viewport.spanDays", "approx": 8, "tolerance": 0.01 },
            { "path": "visible.count", "equals": 5 },
            { "path": "interaction.last", "equals": "zoom" },
            { "path": "interaction.active", "equals": true },
            { "path": "interaction.wheelCaptured", "equals": true }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": { "page": true },
              "property": "scrollTop",
              "equals": 0
            },
            {
              "target": { "role": "status" },
              "property": "contained",
              "equals": true,
              "tolerance": 1
            },
            {
              "target": { "role": "button", "name": "Reset zoom" },
              "property": "contained",
              "equals": true,
              "tolerance": 1
            }
          ]
        },
        {
          "type": "wheel",
          "target": { "view": "main", "anchor": "date:2018-01-10" },
          "deltaX": 220
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-08" },
            { "path": "viewport.end", "equals": "2018-01-16" },
            { "path": "visible.count", "equals": 6 },
            { "path": "interaction.last", "equals": "pan" },
            { "path": "interaction.wheelCaptured", "equals": true }
          ]
        },
        { "type": "screenshot", "name": "focused-zoom-window" },
        { "type": "update", "revision": 1 },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-08" },
            { "path": "viewport.end", "equals": "2018-01-16" },
            { "path": "visible.count", "equals": 6 },
            {
              "path": "visible.jan9Close",
              "equals": 174.330002
            },
            { "path": "interaction.last", "equals": "pan" }
          ]
        },
        { "type": "update", "revision": 0 },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-08" },
            { "path": "viewport.end", "equals": "2018-01-16" },
            { "path": "visible.count", "equals": 6 },
            {
              "path": "visible.jan9Close",
              "equals": 174.330002
            },
            { "path": "interaction.last", "equals": "pan" }
          ]
        },
        {
          "type": "wheel",
          "target": { "view": "main", "anchor": "date:2018-01-10" },
          "deltaY": 240
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-02" },
            { "path": "viewport.end", "equals": "2018-01-18" },
            { "path": "viewport.spanDays", "approx": 16, "tolerance": 0.01 },
            { "path": "visible.count", "equals": 12 },
            { "path": "interaction.last", "equals": "zoom" }
          ]
        }
      ]
    },
    {
      "id": "line-wheel-normalization",
      "steps": [
        {
          "type": "click",
          "target": { "view": "main", "anchor": "date:2018-01-10" }
        },
        {
          "type": "wheel",
          "target": { "view": "main", "anchor": "date:2018-01-10" },
          "deltaY": -15,
          "deltaMode": "line"
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-06" },
            { "path": "viewport.end", "equals": "2018-01-14" },
            { "path": "viewport.spanDays", "approx": 8, "tolerance": 0.01 },
            { "path": "interaction.wheelCaptured", "equals": true }
          ]
        }
      ]
    },
    {
      "id": "page-wheel-normalization",
      "steps": [
        {
          "type": "click",
          "target": { "view": "main", "anchor": "date:2018-01-10" }
        },
        {
          "type": "wheel",
          "target": { "view": "main", "anchor": "date:2018-01-10" },
          "deltaY": -1,
          "deltaMode": "page"
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-06" },
            { "path": "viewport.end", "equals": "2018-01-14" },
            { "path": "viewport.spanDays", "approx": 8, "tolerance": 0.01 },
            { "path": "interaction.wheelCaptured", "equals": true }
          ]
        }
      ]
    },
    {
      "id": "keyboard-pan-and-reset",
      "steps": [
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": { "role": "button", "name": "Reset zoom" },
              "property": "width",
              "atLeast": 44
            },
            {
              "target": { "role": "button", "name": "Reset zoom" },
              "property": "height",
              "atLeast": 44
            }
          ]
        },
        {
          "type": "key",
          "key": "+",
          "target": { "view": "main", "anchor": "date:2018-01-10" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-06" },
            { "path": "viewport.end", "equals": "2018-01-14" },
            { "path": "interaction.active", "equals": true },
            { "path": "interaction.last", "equals": "zoom" }
          ]
        },
        {
          "type": "key",
          "key": "ArrowRight",
          "target": { "view": "main", "anchor": "date:2018-01-10" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-07" },
            { "path": "viewport.end", "equals": "2018-01-15" },
            { "path": "interaction.last", "equals": "pan" }
          ]
        },
        {
          "type": "click",
          "target": { "view": "main", "anchor": "control:reset" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-02" },
            { "path": "viewport.end", "equals": "2018-01-18" },
            { "path": "viewport.spanDays", "approx": 16, "tolerance": 0.01 },
            { "path": "interaction.active", "equals": true },
            { "path": "interaction.last", "equals": "reset" }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": { "role": "status" },
              "property": "text",
              "includes": "2018-01-02 → 2018-01-18"
            },
            {
              "target": { "role": "status" },
              "property": "contained",
              "equals": true,
              "tolerance": 1
            }
          ]
        }
      ]
    },
    {
      "id": "focused-pointer-drag-pan",
      "steps": [
        {
          "type": "key",
          "key": "+",
          "target": { "view": "main", "anchor": "date:2018-01-10" }
        },
        {
          "type": "drag",
          "from": { "view": "main", "anchor": "date:2018-01-10" },
          "to": { "view": "main", "anchor": "date:2018-01-08" },
          "steps": 8
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-08" },
            { "path": "viewport.end", "equals": "2018-01-16" },
            { "path": "interaction.last", "equals": "pan" }
          ]
        }
      ]
    },
    {
      "id": "touch-activation-and-pan",
      "steps": [
        {
          "type": "touchTap",
          "target": { "view": "main", "anchor": "date:2018-01-10" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "interaction.active", "equals": true },
            { "path": "viewport.spanDays", "approx": 16, "tolerance": 0.01 }
          ]
        },
        { "type": "key", "key": "+" },
        {
          "type": "touchDrag",
          "from": { "view": "main", "anchor": "date:2018-01-10" },
          "to": { "view": "main", "anchor": "date:2018-01-08" },
          "steps": 8
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "viewport.start", "equals": "2018-01-08" },
            { "path": "viewport.end", "equals": "2018-01-16" },
            { "path": "interaction.last", "equals": "pan" }
          ]
        }
      ]
    }
  ],
  "source": {
    "title": "Apache ECharts data zoom",
    "url": "https://echarts.apache.org/handbook/en/concepts/datazoom/"
  },
  "ai": {
    "create": "Create a UTC chart of AAPL closes with the first-party zoomX behavior, a controlled semantic window, pointer-anchored wheel zoom, drag and horizontal-wheel pan, keyboard and touch input, status, and reset affordances.",
    "maintain": "Keep the semantic window controlled by the application, let zoomX own resolved-scale inversion and gesture lifecycle, leave wheel and vertical touch scrolling unconsumed until intentional plot focus, and keep status, reset, visible-row, and persistence policy outside the renderer."
  }
}
