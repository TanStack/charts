{
  "schemaVersion": 1,
  "referenceRenderer": "recharts",
  "order": 840,
  "id": "84-pinned-nested-chart-tooltip",
  "title": "Expanding pinned energy tooltip",
  "family": "interaction",
  "intent": "Keep monthly energy totals compact during transient inspection, then smoothly expand the same pinned tooltip into consumption and solar-use detail.",
  "support": "composed",
  "features": [
    "native structured tooltip content",
    "pinned content context",
    "custom tooltip body renderer",
    "click to pin",
    "animated intrinsic height",
    "nested chart",
    "Escape dismissal"
  ],
  "geometry": [
    { "view": "main", "role": "bar", "count": 48 },
    { "view": "main", "role": "dot", "count": 12 }
  ],
  "interactionScenarios": [
    {
      "id": "hover-shows-compact-summary",
      "steps": [
        {
          "type": "pointerMove",
          "target": { "view": "main", "anchor": "month:jun" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "focusedMonth", "equals": "jun" },
            { "path": "tooltip.visible", "equals": true },
            { "path": "tooltip.pinned", "equals": false },
            { "path": "tooltip.role", "equals": "status" },
            { "path": "tooltip.inert", "equals": true },
            { "path": "tooltip.month", "equals": "June" },
            { "path": "tooltip.summaryRowCount", "equals": 2 },
            { "path": "tooltip.detailsExpanded", "equals": false },
            { "path": "tooltip.closeVisible", "equals": false }
          ]
        },
        { "type": "pointerLeave", "view": "main" },
        {
          "type": "assert",
          "assertions": [
            { "path": "focusedMonth", "equals": null },
            { "path": "tooltip.visible", "equals": false }
          ]
        }
      ]
    },
    {
      "id": "pin-expand-and-dismiss-with-escape",
      "steps": [
        {
          "type": "pointerMove",
          "target": { "view": "main", "anchor": "month:jun" }
        },
        {
          "type": "click",
          "target": { "view": "main", "anchor": "month:jun" }
        },
        { "type": "wait", "durationMs": 300 },
        {
          "type": "assert",
          "assertions": [
            { "path": "focusedMonth", "equals": "jun" },
            { "path": "tooltip.visible", "equals": true },
            { "path": "tooltip.pinned", "equals": true },
            { "path": "tooltip.role", "equals": "dialog" },
            { "path": "tooltip.inert", "equals": false },
            { "path": "tooltip.summaryRowCount", "equals": 3 },
            { "path": "tooltip.detailsExpanded", "equals": true },
            { "path": "tooltip.detailRowCount", "equals": 6 },
            { "path": "tooltip.nestedBarCount", "equals": 4 },
            { "path": "tooltip.closeVisible", "equals": true },
            { "path": "tooltip.text", "includes": "EV charging" }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": { "selector": ".energy-tooltip__reveal" },
              "property": "height",
              "atLeast": 180
            },
            {
              "target": {
                "role": "button",
                "name": "Close energy details",
                "exact": true
              },
              "property": "visible",
              "equals": true
            },
            {
              "target": {
                "role": "button",
                "name": "Close energy details",
                "exact": true
              },
              "property": "width",
              "atLeast": 36
            }
          ]
        },
        { "type": "screenshot", "name": "pinned-energy-tooltip-expanded" },
        {
          "type": "key",
          "key": "Escape",
          "target": { "view": "main", "anchor": "month:jun" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "focusedMonth", "equals": null },
            { "path": "tooltip.visible", "equals": false },
            { "path": "tooltip.pinned", "equals": false }
          ]
        }
      ]
    },
    {
      "id": "close-button-dismisses",
      "steps": [
        {
          "type": "pointerMove",
          "target": { "view": "main", "anchor": "month:mar" }
        },
        {
          "type": "click",
          "target": { "view": "main", "anchor": "month:mar" }
        },
        { "type": "wait", "durationMs": 300 },
        {
          "type": "click",
          "target": { "view": "main", "anchor": "tooltip:close" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "focusedMonth", "equals": null },
            { "path": "tooltip.visible", "equals": false },
            { "path": "tooltip.pinned", "equals": false }
          ]
        }
      ]
    },
    {
      "id": "keyboard-focus-pins-and-expands",
      "steps": [
        {
          "type": "key",
          "key": "Enter",
          "target": { "view": "main", "anchor": "month:jan" }
        },
        { "type": "wait", "durationMs": 300 },
        {
          "type": "assert",
          "assertions": [
            { "path": "focusedMonth", "equals": "jan" },
            { "path": "tooltip.visible", "equals": true },
            { "path": "tooltip.pinned", "equals": true },
            { "path": "tooltip.role", "equals": "dialog" },
            { "path": "tooltip.summaryRowCount", "equals": 3 },
            { "path": "tooltip.detailsExpanded", "equals": true },
            { "path": "tooltip.detailRowCount", "equals": 6 },
            { "path": "tooltip.closeVisible", "equals": true }
          ]
        },
        {
          "type": "key",
          "key": "Escape",
          "target": { "view": "main", "anchor": "month:jan" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "focusedMonth", "equals": null },
            { "path": "tooltip.visible", "equals": false },
            { "path": "tooltip.pinned", "equals": false }
          ]
        }
      ]
    }
  ],
  "source": {
    "title": "Dan Marek expanding energy tooltip interaction",
    "url": "https://x.com/dan__marek/status/2083202252219559958"
  },
  "ai": {
    "create": "Create a twelve-month household energy chart with stacked consumption bars and a solar-generation line. Hover or keyboard focus shows only monthly totals. Click, Enter, or Space pins that tooltip, adds a solar-coverage row through the structured content callback, and smoothly reveals consumption plus generation-use details through the framework renderer. Keep the detailed subtree mounted and animate its intrinsic height from zero to auto with a one-row grid.",
    "maintain": "Preserve twelve stable month IDs, four consumption segments per month, the compact two-row transient summary, pinned-only solar coverage, six detailed rows, a four-segment nested chart, native inert/status versus interactive/dialog semantics, reduced-motion behavior, and Escape plus close-button dismissal."
  }
}
