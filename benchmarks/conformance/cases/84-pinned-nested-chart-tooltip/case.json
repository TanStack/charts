{
  "schemaVersion": 1,
  "referenceRenderer": "recharts",
  "order": 840,
  "id": "84-pinned-nested-chart-tooltip",
  "title": "Pinned penguin tooltip with a nested chart",
  "family": "interaction",
  "intent": "Pin a penguin observation on click and compare four nearby same-species observations in a real secondary chart without making hover destructive.",
  "support": "composed",
  "features": [
    "external rich tooltip",
    "definition-owned pin-only tooltip",
    "click to pin",
    "hover without activation",
    "nested chart",
    "Escape dismissal"
  ],
  "geometry": [
    {
      "view": "main",
      "role": "dot",
      "count": 5
    }
  ],
  "interactionScenarios": [
    {
      "id": "hover-does-not-open-tooltip",
      "steps": [
        {
          "type": "pointerMove",
          "target": {
            "view": "main",
            "anchor": "point:adelie-biscoe-female"
          }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "hoveredId", "equals": "adelie-biscoe-female" },
            { "path": "tooltip.visible", "equals": false },
            { "path": "tooltip.pinnedId", "equals": null },
            { "path": "tooltip.miniBarCount", "equals": 0 }
          ]
        },
        { "type": "pointerLeave", "view": "main" },
        {
          "type": "assert",
          "assertions": [
            { "path": "hoveredId", "equals": null },
            { "path": "tooltip.visible", "equals": false }
          ]
        }
      ]
    },
    {
      "id": "pin-and-dismiss-with-escape",
      "steps": [
        {
          "type": "click",
          "target": {
            "view": "main",
            "anchor": "point:gentoo-biscoe-male"
          }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "tooltip.visible", "equals": true },
            { "path": "tooltip.pinnedId", "equals": "gentoo-biscoe-male" },
            { "path": "tooltip.miniBarCount", "equals": 4 },
            { "path": "tooltip.chartCount", "equals": 1 }
          ]
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "tooltip.pinnedMarkCount", "equals": 1 },
            { "path": "tooltip.flipperLabelCount", "equals": 4 },
            { "path": "tooltip.closeVisible", "equals": true }
          ]
        },
        {
          "type": "assertRendered",
          "assertions": [
            {
              "target": {
                "selector": "[data-external-tooltip=\"pinned\"]"
              },
              "property": "visible",
              "equals": true
            },
            {
              "target": {
                "role": "button",
                "name": "Close pinned penguin details",
                "exact": true
              },
              "property": "visible",
              "equals": true
            },
            {
              "target": {
                "role": "button",
                "name": "Close pinned penguin details",
                "exact": true
              },
              "property": "height",
              "atLeast": 44
            },
            {
              "target": {
                "role": "button",
                "name": "Close pinned penguin details",
                "exact": true
              },
              "property": "width",
              "atLeast": 44
            },
            {
              "target": {
                "role": "dialog",
                "name": "Gentoo male on Biscoe",
                "exact": false
              },
              "property": "attribute",
              "attribute": "aria-modal",
              "equals": "false"
            },
            {
              "target": {
                "role": "region",
                "name": "Penguin measurements with a pinned nested-chart tooltip",
                "exact": true
              },
              "property": "count",
              "equals": 1
            }
          ]
        },
        { "type": "screenshot", "name": "pinned-nested-chart-open" },
        {
          "type": "key",
          "key": "Escape",
          "target": {
            "view": "main",
            "anchor": "point:gentoo-biscoe-male"
          }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "tooltip.visible", "equals": false },
            { "path": "tooltip.pinnedId", "equals": null },
            { "path": "tooltip.miniBarCount", "equals": 0 },
            { "path": "chartFocused", "equals": true }
          ]
        }
      ]
    },
    {
      "id": "close-button-dismisses",
      "steps": [
        {
          "type": "click",
          "target": {
            "view": "main",
            "anchor": "point:chinstrap-dream-male"
          }
        },
        {
          "type": "click",
          "target": {
            "view": "main",
            "anchor": "tooltip:close"
          }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "tooltip.visible", "equals": false },
            { "path": "tooltip.pinnedId", "equals": null },
            { "path": "tooltip.pinnedMarkCount", "equals": 0 },
            { "path": "chartFocused", "equals": true }
          ]
        }
      ]
    },
    {
      "id": "second-click-unpins",
      "steps": [
        {
          "type": "click",
          "target": {
            "view": "main",
            "anchor": "point:adelie-biscoe-female"
          }
        },
        {
          "type": "click",
          "target": {
            "view": "main",
            "anchor": "point:adelie-biscoe-female"
          }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "tooltip.visible", "equals": false },
            { "path": "tooltip.pinnedId", "equals": null },
            { "path": "tooltip.miniBarCount", "equals": 0 }
          ]
        }
      ]
    },
    {
      "id": "pinned-update-preserves-semantic-point",
      "steps": [
        {
          "type": "click",
          "target": {
            "view": "main",
            "anchor": "point:adelie-dream-female"
          }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "tooltip.visible", "equals": true },
            { "path": "tooltip.pinnedId", "equals": "adelie-dream-female" },
            { "path": "tooltip.pinnedMarkCount", "equals": 1 },
            { "path": "tooltip.chartCount", "equals": 1 }
          ]
        },
        { "type": "update", "revision": 1 },
        {
          "type": "assert",
          "assertions": [
            { "path": "tooltip.visible", "equals": true },
            { "path": "tooltip.pinnedId", "equals": "adelie-dream-female" },
            { "path": "tooltip.pinnedMarkCount", "equals": 1 },
            { "path": "tooltip.miniBarCount", "equals": 4 },
            { "path": "tooltip.chartCount", "equals": 1 }
          ]
        }
      ]
    }
  ],
  "source": {
    "title": "Recharts custom tooltip content",
    "url": "https://recharts.github.io/en-US/examples/CustomContentOfTooltip/"
  },
  "ai": {
    "create": "Create a selectable penguin chart where hover only exposes focus state, clicking pins an external tooltip, and the tooltip mounts a four-bar same-species comparison.",
    "maintain": "Keep hover and pinned selection separate, key the five displayed cohort representatives by species, island, and sex, destroy nested chart hosts when hidden, and preserve Escape plus second-click dismissal."
  }
}
