{
  "schemaVersion": 1,
  "referenceRenderer": "echarts",
  "order": 860,
  "id": "86-streaming-window-preservation",
  "title": "Streaming window preservation",
  "family": "interaction",
  "intent": "Append stable-key observations without moving a user-locked time viewport.",
  "support": "composed",
  "features": [
    "deterministic streaming",
    "locked viewport domain",
    "stable data keys",
    "accessible append control",
    "dynamic chart definition"
  ],
  "geometry": [
    { "view": "main", "role": "line", "count": 1 },
    { "view": "main", "role": "dot", "count": 8 }
  ],
  "minimumGeometrySimilarity": 0.995,
  "guideAssertions": [
    {
      "id": "value-sequence",
      "axis": "y",
      "sequence": ["0", "20", "40", "60", "80"]
    }
  ],
  "interactionScenarios": [
    {
      "id": "append-outside-locked-window",
      "steps": [
        {
          "type": "assert",
          "assertions": [
            { "path": "data.count", "equals": 12 },
            { "path": "visible.count", "equals": 8 },
            { "path": "viewport.start", "equals": "2025-01-05" },
            { "path": "viewport.end", "equals": "2025-01-12" },
            { "path": "viewport.locked", "equals": true }
          ]
        },
        {
          "type": "click",
          "target": { "view": "main", "anchor": "control:append" }
        },
        {
          "type": "assert",
          "assertions": [
            { "path": "data.count", "equals": 13 },
            { "path": "data.ids", "includes": "sample-12" },
            { "path": "data.domainEnd", "equals": "2025-01-13" },
            { "path": "visible.count", "equals": 8 },
            { "path": "viewport.start", "equals": "2025-01-05" },
            { "path": "viewport.end", "equals": "2025-01-12" },
            { "path": "viewport.locked", "equals": true },
            { "path": "control.appended", "equals": 1 }
          ]
        },
        { "type": "update", "revision": 1 },
        {
          "type": "assert",
          "assertions": [
            { "path": "data.count", "equals": 13 },
            { "path": "data.ids", "includes": "sample-12" },
            { "path": "visible.count", "equals": 8 },
            { "path": "visible.revisionProbeValue", "equals": 49 },
            { "path": "viewport.start", "equals": "2025-01-05" },
            { "path": "viewport.end", "equals": "2025-01-12" },
            { "path": "viewport.locked", "equals": true },
            { "path": "control.appended", "equals": 1 }
          ]
        },
        { "type": "update", "revision": 0 },
        {
          "type": "assert",
          "assertions": [
            { "path": "data.count", "equals": 13 },
            { "path": "data.ids", "includes": "sample-12" },
            { "path": "visible.count", "equals": 8 },
            { "path": "visible.revisionProbeValue", "equals": 44 },
            { "path": "viewport.start", "equals": "2025-01-05" },
            { "path": "viewport.end", "equals": "2025-01-12" },
            { "path": "viewport.locked", "equals": true },
            { "path": "control.appended", "equals": 1 }
          ]
        }
      ]
    }
  ],
  "source": {
    "title": "Apache ECharts dynamic data",
    "url": "https://echarts.apache.org/handbook/en/how-to/data/dynamic-data/"
  },
  "ai": {
    "create": "Create a deterministic streaming line chart with an accessible append control and a user-owned UTC viewport that does not move when new observations arrive.",
    "maintain": "Keep observation IDs stable, derive the visible slice from the explicit viewport, and update data independently from the locked scale domain."
  }
}
