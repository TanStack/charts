        "node": "./dist/server/canvas.js",
        "import": "./dist/canvas.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "browser": "./dist/core.js",
        "node": "./dist/server/core.js",
        "import": "./dist/core.js"
      }
