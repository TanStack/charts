{
  "name": "@tanstack/react-charts",
  "version": "1.1.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TanStack/charts.git",
    "directory": "packages/react-charts"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./canvas": "./src/canvas.ts",
    "./core": "./src/core.ts",
    "./tooltip": "./src/tooltip.tsx",
    "./city": "./src/city.ts",
    "./city/styles.css": "./src/city/styles.css",
    "./city/theme-default.css": "./src/city/theme-default.css",
    "./city/theme-tailwind.css": "./src/city/theme-tailwind.css"
  },
  "dependencies": {
    "@tanstack/charts": "workspace:*"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "d3-scale": "4.0.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": "^0.180.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./canvas": {
        "types": "./dist/canvas.d.ts",
        "import": "./dist/canvas.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js"
      },
      "./tooltip": {
        "types": "./dist/tooltip.d.ts",
        "import": "./dist/tooltip.js"
      },
      "./city": {
        "types": "./dist/city.d.ts",
        "import": "./dist/city.js"
      },
      "./city/styles.css": {
        "default": "./dist/city/styles.css"
      },
      "./city/theme-default.css": {
        "default": "./dist/city/theme-default.css"
      },
      "./city/theme-tailwind.css": {
        "default": "./dist/city/theme-tailwind.css"
      }
    }
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
