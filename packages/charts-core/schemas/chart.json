        },
        "z": {
          "$ref": "#/$defs/argument:channel"
        },
        "color": {
          "$ref": "#/$defs/argument:channel"
        },
        "key": {
          "$ref": "#/$defs/argument:channel"
        },
        "y1": {
          "$ref": "#/$defs/argument:numeric-channel"
        },
        "y2": {
          "$ref": "#/$defs/argument:numeric-channel"
        },
        "fill": {
          "$ref": "#/$defs/argument:string"
        },
        "fillOpacity": {
          "$ref": "#/$defs/argument:opacity"
        },
        "stroke": {
          "$ref": "#/$defs/argument:string"
        },
        "strokeWidth": {
          "$ref": "#/$defs/argument:nonnegative-number"
        },
        "layout": {
          "$ref": "#/$defs/argument:layout"
        },
        "inset": {
          "$ref": "#/$defs/argument:finite-number"
        },
        "maxThickness": {
          "$ref": "#/$defs/argument:nonnegative-number"
