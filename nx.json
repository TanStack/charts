{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "useInferencePlugins": false,
  "parallel": 5,
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.json"
    ],
    "source": [
      "sharedGlobals",
      "{workspaceRoot}/packages/**/*",
      "{workspaceRoot}/examples/**/*",
      "{workspaceRoot}/benchmarks/**/*",
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/vitest*.config.ts",
      "!{workspaceRoot}/**/CHANGELOG.md",
      "!{workspaceRoot}/**/README.md",
      "!{workspaceRoot}/**/dist/**/*",
      "!{workspaceRoot}/packages/*/docs/**/*",
      "!{workspaceRoot}/packages/*/llms.txt"
    ],
    "testDom": [
      "source",
      "docsTest",
      "{workspaceRoot}/.nx/workflows/**/*.yaml",
      "{workspaceRoot}/.github/actions/**/*.yml",
      "{workspaceRoot}/.github/workflows/**/*.yml"
    ],
    "format": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/.benchmark-output/**/*",
      "!{workspaceRoot}/.bundle-output/**/*",
      "!{workspaceRoot}/.catalog-artifact/**/*",
      "!{workspaceRoot}/.nx/cache/**/*",
      "!{workspaceRoot}/.nx/prettier-cache",
      "!{workspaceRoot}/.nx/typescript/**/*",
      "!{workspaceRoot}/.nx/workspace-data/**/*",
      "!{workspaceRoot}/.release-artifacts/**/*",
      "!{workspaceRoot}/node_modules/**/*"
    ],
    "docs": [
      "sharedGlobals",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/CONTRIBUTING.md",
      "{workspaceRoot}/CHANGELOG.md",
      "{workspaceRoot}/llms.txt",
      "{workspaceRoot}/docs/**/*",
      "{workspaceRoot}/media/**/*",
      "{workspaceRoot}/packages/*/README.md",
      "{workspaceRoot}/packages/*/package.json",
      "{workspaceRoot}/packages/*/src/**/*",
      "{workspaceRoot}/packages/charts-core/docs/**/*",
      "{workspaceRoot}/packages/charts-core/llms.txt",
      "{workspaceRoot}/benchmarks/conformance/**/*",
      "{workspaceRoot}/benchmarks/comparison/bundle-baseline.json",
      "{workspaceRoot}/scripts/benchmark/chart-libraries.mjs",
      "{workspaceRoot}/scripts/benchmark/comparison-capabilities.mjs",
      "{workspaceRoot}/scripts/check-docs.mjs",
      "{workspaceRoot}/scripts/docs-contract.mjs",
      "{workspaceRoot}/scripts/packed-markdown-links.mjs",
      "{workspaceRoot}/scripts/sync-package-docs.mjs"
    ],
    "docsTest": [
      "docs",
      "{workspaceRoot}/API-FRICTION.md",
      "{workspaceRoot}/MARKETING.md",
      "{workspaceRoot}/benchmarks/conformance/api-friction.test.ts",
      "{workspaceRoot}/scripts/sync-release-version.mjs",
      "{workspaceRoot}/scripts/sync-release-version.test.mjs"
    ],
    "release": [
      "sharedGlobals",
      "{workspaceRoot}/LICENSE",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/docs/**/*",
      "{workspaceRoot}/packages/charts-core/**/*",
      "{workspaceRoot}/packages/charts-scales/**/*",
      "{workspaceRoot}/packages/*-charts/**/*",
      "{workspaceRoot}/examples/charts-react-native/**/*",
      "{workspaceRoot}/examples/charts-expo/**/*",
      "!{workspaceRoot}/packages/*/dist/**/*",
      "{workspaceRoot}/scripts/*package*.mjs",
      "{workspaceRoot}/scripts/*release*.mjs",
      "{workspaceRoot}/scripts/check-framework-adapters.mjs",
      "{workspaceRoot}/scripts/check-packed-consumers.mjs",
      "{workspaceRoot}/scripts/packed-react-native-consumers.mjs",
      "{workspaceRoot}/scripts/packed-markdown-links.mjs",
      "{workspaceRoot}/scripts/run-with-concurrency.mjs"
    ],
    "reactNativeTypes": [
      "sharedGlobals",
      "{workspaceRoot}/scripts/check-react-native-types.mjs",
      "{workspaceRoot}/packages/charts-core/**/*",
      "{workspaceRoot}/packages/react-native-charts/**/*",
      "{workspaceRoot}/examples/charts-react-native/**/*",
      "{workspaceRoot}/examples/charts-expo/**/*",
      "!{workspaceRoot}/packages/*/dist/**/*"
    ],
    "testSolid": [
      "sharedGlobals",
      "{workspaceRoot}/vitest.solid*.config.ts",
      "{workspaceRoot}/packages/charts-core/**/*",
      "{workspaceRoot}/packages/solid-charts/**/*",
      "!{workspaceRoot}/packages/*/dist/**/*",
      "!{workspaceRoot}/packages/**/CHANGELOG.md",
      "!{workspaceRoot}/packages/**/README.md",
      "!{workspaceRoot}/packages/*/docs/**/*",
      "!{workspaceRoot}/packages/*/llms.txt"
    ],
    "testSvelte": [
      "sharedGlobals",
      "{workspaceRoot}/vitest.svelte*.config.ts",
      "{workspaceRoot}/packages/charts-core/**/*",
      "{workspaceRoot}/packages/svelte-charts/**/*",
      "!{workspaceRoot}/packages/*/dist/**/*",
      "!{workspaceRoot}/packages/**/CHANGELOG.md",
      "!{workspaceRoot}/packages/**/README.md",
      "!{workspaceRoot}/packages/*/docs/**/*",
      "!{workspaceRoot}/packages/*/llms.txt"
    ],
    "testOctane": [
      "sharedGlobals",
      "{workspaceRoot}/vitest.octane*.config.ts",
      "{workspaceRoot}/packages/charts-core/**/*",
      "{workspaceRoot}/packages/core/**/*",
      "{workspaceRoot}/packages/octane/**/*",
      "{workspaceRoot}/packages/octane-charts/**/*",
      "{workspaceRoot}/packages/plot/**/*",
      "!{workspaceRoot}/packages/*/dist/**/*",
      "!{workspaceRoot}/packages/**/CHANGELOG.md",
      "!{workspaceRoot}/packages/**/README.md",
      "!{workspaceRoot}/packages/*/docs/**/*",
      "!{workspaceRoot}/packages/*/llms.txt"
    ],
    "catalogSource": [
      "sharedGlobals",
      "{workspaceRoot}/examples/conformance/**/*",
      "{workspaceRoot}/benchmarks/conformance/**/*",
      "{workspaceRoot}/packages/charts-core/package.json",
      "{workspaceRoot}/packages/charts-core/src/**/*",
      "{workspaceRoot}/packages/charts-demo-data/package.json",
      "{workspaceRoot}/packages/charts-demo-data/src/**/*",
      "{workspaceRoot}/packages/react-charts/package.json",
      "{workspaceRoot}/packages/react-charts/src/**/*",
      "{workspaceRoot}/scripts/build-conformance-artifact.mjs",
      "{workspaceRoot}/scripts/catalog-artifact.mjs",
      "{workspaceRoot}/scripts/catalog-source-revision.mjs",
      "{workspaceRoot}/scripts/catalog-source-files.mjs",
      "{workspaceRoot}/scripts/check-catalog-loading.mjs",
      "{workspaceRoot}/scripts/check-conformance-artifact.mjs",
      "!{workspaceRoot}/examples/conformance/dist/**/*"
    ],
    "catalogRevision": [
      {
        "runtime": "node scripts/catalog-source-revision.mjs"
      }
    ],
    "comparisonRevision": [
      {
        "runtime": "git log -1 --format=%H -- benchmarks/comparison/libraries/tanstack packages/charts-core/src benchmarks/comparison/libraries/tier.ts benchmarks/comparison/stress/operation.ts benchmarks/comparison/types.ts"
      }
    ]
  },
  "targetDefaults": {
    "format-check": {
      "cache": true,
      "inputs": ["format"]
    },
    "docs-check": {
      "cache": true,
      "inputs": ["docs"]
    },
    "docs-test": {
      "cache": true,
      "inputs": ["docsTest"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["source"]
    },
    "test-*": {
      "cache": true,
      "inputs": ["source"]
    },
    "test-dom": {
      "cache": true,
      "inputs": ["testDom"]
    },
    "test-solid": {
      "cache": true,
      "inputs": ["testSolid"]
    },
    "test-solid-ssr": {
      "cache": true,
      "inputs": ["testSolid"]
    },
    "test-svelte": {
      "cache": true,
      "inputs": ["testSvelte"]
    },
    "test-svelte-ssr": {
      "cache": true,
      "inputs": ["testSvelte"]
    },
    "test-octane": {
      "cache": true,
      "inputs": ["testOctane"]
    },
    "test-octane-client": {
      "cache": true,
      "inputs": ["testOctane"]
    },
    "adapters-check": {
      "cache": true,
      "inputs": ["release"]
    },
    "react-native-types": {
      "cache": true,
      "inputs": ["reactNativeTypes"]
    },
    "package-check": {
      "cache": true,
      "inputs": ["release"]
    },
    "bundle": {
      "cache": true,
      "inputs": ["source"],
      "outputs": ["{workspaceRoot}/.bundle-output"]
    },
    "bundle-check": {
      "cache": true,
      "inputs": ["source"],
      "outputs": ["{workspaceRoot}/.bundle-output"]
    },
    "benchmark-check": {
      "cache": true,
      "inputs": ["source", "comparisonRevision"],
      "outputs": ["{workspaceRoot}/.benchmark-output/results"]
    },
    "catalog-check": {
      "cache": true,
      "inputs": ["catalogSource"]
    },
    "catalog-vite-build": {
      "cache": true,
      "inputs": ["catalogSource"],
      "outputs": ["{workspaceRoot}/examples/conformance/dist"]
    },
    "catalog-artifact-build": {
      "cache": true,
      "inputs": ["catalogSource", "catalogRevision"],
      "outputs": ["{workspaceRoot}/.catalog-artifact"]
    },
    "catalog-loading-check": {
      "cache": true,
      "inputs": ["catalogSource"]
    },
    "release-artifacts": {
      "cache": true,
      "inputs": ["release"],
      "outputs": ["{workspaceRoot}/.release-artifacts"]
    }
  },
  "nxCloudId": "6a728964bb91bb09533eb006"
}
